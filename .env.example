# Lark custom bot webhook.
# Example: https://open.larksuite.com/open-apis/bot/v2/hook/xxxxxxxx
LARK_WEBHOOK_URL=

# Optional custom bot signing secret.
LARK_WEBHOOK_SECRET=

# Set to 1 to print the Lark payload without sending it.
LARK_DRY_RUN=0

# Optional delivery tuning.
LARK_MAX_CHARS=6000
LARK_LOCALE=zh_cn

# X API v2 app-only Bearer Token. X sources remain disabled until configured.
X_BEARER_TOKEN=

# Optional HTTP proxy for Node fetch and the curl fallback.
# Node 24 requires NODE_USE_ENV_PROXY=1 to read the proxy variables.
NODE_USE_ENV_PROXY=1
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# When the proxy runs on the Docker host, use:
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
#
# Prefer an HTTP or Clash mixed proxy port. Node's built-in environment proxy
# support does not use SOCKS URLs directly.
