{
  "name": "personal-news-intelligence",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Personal news intelligence system with RSS ingestion, clustering, bilingual reports, and a local dashboard.",
  "scripts": {
    "init-db": "node --experimental-strip-types src/cli.ts init-db",
    "ingest": "node --experimental-strip-types src/cli.ts ingest",
    "brief": "node --experimental-strip-types src/cli.ts brief",
    "cluster": "node --experimental-strip-types src/cli.ts cluster",
    "sources": "node --experimental-strip-types src/cli.ts sources",
    "stats": "node --experimental-strip-types src/cli.ts stats",
    "serve": "node --experimental-strip-types src/cli.ts serve",
    "run": "node --experimental-strip-types src/cli.ts run",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  }
}
